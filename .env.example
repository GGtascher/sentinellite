# Copy to .env for Docker Compose. Change passwords outside local development.
POSTGRES_DB=sentinellite
POSTGRES_USER=sentinellite
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://sentinellite:change-me-local-only@db:5432/sentinellite
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
MAX_EVENT_CHARS=262144
LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8000/api/v1
